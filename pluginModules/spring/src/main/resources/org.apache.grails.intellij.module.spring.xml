<!--
  Optional content module: the Spring Support integration (injected-bean typing and completion,
  gutter navigation, Grails artefacts registered as Spring beans, the Spring facet, bean-name
  references and rename/usage search). Skipped when the Spring plugin is absent (Community
  Edition), so the main jar never references the Spring API. The Spring plugin's classes live
  in its intellij.spring / intellij.spring.core content modules, which a plugin-id dependency
  alone does not expose, hence the explicit module dependencies.

  The Spring-free beans {} DSL support (GrailsResourcesGroovyMemberContributor) stays in the
  main plugin and works on both editions.
-->
<idea-plugin>

  <resource-bundle>messages.GrailsBundle</resource-bundle>

  <dependencies>
    <plugin id="com.intellij.spring"/>
    <module name="intellij.spring"/>
    <module name="intellij.spring.core"/>
  </dependencies>

  <extensions defaultExtensionNs="org.intellij.grails">
    <facetProvider implementation="org.apache.grails.intellij.module.spring.GrailsSpringFacetProvider"/>
    <namedArgumentReferenceContributor implementation="org.apache.grails.intellij.module.spring.GrailsSpringMethodReferenceProvider"/>
  </extensions>

  <extensions defaultExtensionNs="org.intellij.groovy">
    <membersContributor implementation="org.apache.grails.intellij.module.spring.GrailsWebApplicationContextMembersContributor"/>
    <variableEnhancer implementation="org.apache.grails.intellij.module.spring.InjectedSpringBeanProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <renamePsiElementProcessor implementation="org.apache.grails.intellij.module.spring.GrLightVariableRenameProcessor" id="GrLightVariableRenameProcessor"/>
    <spring.customModuleComponentsDiscoverer implementation="org.apache.grails.intellij.module.spring.GrailsSpringBeanDiscoverer"/>
    <codeInsight.lineMarkerProvider language="Groovy" implementationClass="org.apache.grails.intellij.module.spring.SpringInjectionAnnotator"/>
    <completion.contributor language="Groovy" implementationClass="org.apache.grails.intellij.module.spring.GrailsInjectedBeanCompletionContributor" order="before groovyBasic"/>
    <aliasingPsiTargetMapper implementation="org.apache.grails.intellij.module.spring.SpringGrailsTargetMapper"/>
    <aliasingPsiTargetMapper implementation="org.apache.grails.intellij.module.spring.GrailsSpringStereotypeAliasingPsiTargetMapper"/>
    <referencesSearch implementation="org.apache.grails.intellij.module.spring.SpringBeanReferenceSearcher"/>
    <semContributor implementation="org.apache.grails.intellij.module.spring.GrailsSpringSemContributor"/>
  </extensions>

</idea-plugin>
