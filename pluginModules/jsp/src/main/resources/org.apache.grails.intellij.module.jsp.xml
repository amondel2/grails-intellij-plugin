<idea-plugin>

  <!-- com.intellij.jsp is a Marketplace plugin since 2026.2, so this module loads only where the
       user installed it. Everything the main plugin itself needs comes from the intellij.jsp and
       intellij.jsp.spi modules the Java plugin bundles. -->
  <dependencies>
    <plugin id="com.intellij.jsp"/>
  </dependencies>

  <extensions defaultExtensionNs="org">
    <intellij.grails.viewFileTypeProvider implementation="org.apache.grails.intellij.module.jsp.JspViewFileTypeProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <referencesSearch implementation="org.apache.grails.intellij.module.jsp.JspPageReferenceSearcher"/>
  </extensions>
</idea-plugin>
