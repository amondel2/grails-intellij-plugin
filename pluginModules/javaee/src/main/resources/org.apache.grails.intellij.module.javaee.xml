<!--
  Optional content module: the Java EE web-facet integration, skipped when the Jakarta EE
  plugins are absent (Community Edition). A plugin id alone only exposes that plugin's main
  module, and the JavaEE plugin's main module is an empty shell: WebFacet, WebRoot and
  WebFacetConfiguration ship in its intellij.javaee.web content module and WebFacetType in the
  com.intellij.javaee.web plugin, so both are declared explicitly.
-->
<idea-plugin>

  <dependencies>
    <plugin id="com.intellij.javaee"/>
    <plugin id="com.intellij.javaee.web"/>
    <module name="intellij.javaee.web"/>
    <module name="intellij.javaee.platform"/>
    <module name="intellij.javaee.platform.impl"/>
  </dependencies>

  <extensions defaultExtensionNs="org.intellij.grails">
    <facetProvider implementation="org.apache.grails.intellij.module.javaee.GrailsWebFacetProvider"/>
  </extensions>

</idea-plugin>
