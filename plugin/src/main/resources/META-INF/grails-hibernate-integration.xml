<!--
  Optional Hibernate integration. Loaded only when com.intellij.hibernate is present (see the
  matching <depends config-file> in plugin.xml). The implementation classes live in the
  pluginModules-hibernate content module; their jar is always shipped and shares the plugin
  classloader. com.intellij.persistence is a transitive part of the Hibernate distribution.
-->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <persistence.packagesProvider implementation="org.apache.grails.intellij.module.hibernate.GormSessionFactoryContributor"/>
    <postStartupActivity implementation="org.apache.grails.intellij.module.hibernate.Grails3HibernateFacetActivity"/>
  </extensions>

  <extensions defaultExtensionNs="org.intellij.grails">
    <facetProvider implementation="org.apache.grails.intellij.module.hibernate.GormHibernateFacetProvider"/>
  </extensions>
</idea-plugin>